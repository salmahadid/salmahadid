                  "title": "Server portal lumpuh akibat serangan DoS",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Penyerang membanjiri portal dengan request (brute force login / HTTP flood) sehingga layanan hasil laboratorium tidak dapat diakses pasien.",
                  "mitigation": "Terapkan rate limiting, CAPTCHA pada login, WAF/anti-DDoS, auto-scaling, dan pemantauan trafik dengan alert otomatis.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
